* text=auto
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
# These are retained upstream license payloads; preserve their exact bytes and
# existing whitespace so notice verification is stable on every Git platform.
app/src/main/assets/notices/binary-dependencies.txt -text whitespace=-blank-at-eol,-blank-at-eof
app/src/main/assets/notices/rust-stdlib-1.90.0.html -text whitespace=-blank-at-eol,-blank-at-eof
binary-engine/licenses/* -text whitespace=-blank-at-eof
app/src/main/assets/notices/mpv-runtime.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
media-engine/licenses/* -text whitespace=-blank-at-eol,-blank-at-eof
app/src/main/assets/notices/android-resources-32.5.1.txt -text whitespace=-blank-at-eol,-blank-at-eof
# Unified patch context uses a single space for an unchanged empty source line.
patches/android-resource-engine.patch whitespace=-blank-at-eol
